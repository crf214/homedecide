# ── Supabase ──────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Database (Prisma) ──────────────────────────────────────
# Get from: Supabase → Project Settings → Database → Connection string
# Use the "Transaction" pooler URL for DATABASE_URL
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Use the direct connection for DIRECT_URL (migrations)
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# ── Session secret (generate with: openssl rand -hex 32) ──
SESSION_SECRET=generate_a_random_32_char_secret_here

# ── Anthropic (for AI insights) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase Storage bucket name ──────────────────────────
SUPABASE_STORAGE_BUCKET=property-photos

# ── App URL ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Listing watcher (daily new-listing email alerts) ──────
# Resend API key — sign up free at https://resend.com → API Keys
RESEND_API_KEY=re_...
# Where alerts are sent (comma-separate for multiple recipients)
ALERT_EMAIL_TO=charles.falck@gmail.com
# From address. Use onboarding@resend.dev for testing (only delivers to
# your own Resend account email); switch to an address on a verified domain
# once you've verified one in Resend.
ALERT_EMAIL_FROM=onboarding@resend.dev
# Shared secret protecting the cron endpoint. Vercel Cron sends it as a
# Bearer token automatically when this env var is set on the project.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate_a_random_secret_here
